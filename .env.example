# Copy to .env.local for local development; set the same in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API (the "publishable" key may also be shown as "anon"; the "secret" key as "service_role").
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: never prefix with NEXT_PUBLIC_, never put in an app.
SUPABASE_SECRET_KEY=

# Who may use Prime Console (comma-separated; must also be users in Supabase → Authentication).
ADMIN_EMAILS=israelnjor@gmail.com

# Any long random text: IP addresses are stored only as hashes made with it.
IP_SALT=

# Push notifications: run `npm run vapid` once and paste the two keys. VAPID_CONTACT is your email.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=you@example.com

# Optional: an email for each new report (resend.com, free tier).
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=Prime Feedback <onboarding@resend.dev>
